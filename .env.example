# Copy to .env and fill in. Never commit .env.

# OpenAQ: each member uses their own key (explore.openaq.org/account)
OPENAQ_API_KEY=

# aqicn: only for live comparison, data must not be stored (see docs/data-sources.md)
AQICN_TOKEN=

# LLM for explanations (sprint 2). Set a spending limit on the provider side.
LLM_API_KEY=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brweather
POSTGRES_USER=brweather
POSTGRES_PASSWORD=change-me

# OpenAQ location ids actively updating in Hanoi (checked 31/10/2026)
ACTIVE_STATION_IDS=2161306,2161292,4946812,4946813,6123215
