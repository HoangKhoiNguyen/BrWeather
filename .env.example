# Copy to .env and fill in. Never commit .env.

# OpenAQ: each member uses their own key (explore.openaq.org/account)
OPENAQ_API_KEY=

# aqicn: only for live comparison, data must not be stored (see docs/data-sources.md)
AQICN_TOKEN=

# LLM for explanations (sprint 2). Set a spending limit on the provider side.
LLM_API_KEY=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brweather
POSTGRES_USER=brweather
# Máy chủ chung: bắt buộc đổi (gợi ý: openssl rand -base64 24)
POSTGRES_PASSWORD=change-me

# OpenAQ location ids actively updating in Hanoi (checked 31/10/2026)
ACTIVE_STATION_IDS=2161306,2161292,4946812,4946813,6123215

# --- Môi trường Docker (C-03). Máy cá nhân giữ nguyên mặc định là được. ---
# Địa chỉ mở cổng Postgres. 127.0.0.1 = chỉ máy đó. Máy chủ chung: đặt IP Tailscale (100.x.y.z).
# Không đặt 0.0.0.0 trên VPS có IP công khai.
DB_BIND_ADDR=127.0.0.1
DB_HOST_PORT=5432
# Địa chỉ mở cổng API backend. Máy cá nhân: 0.0.0.0 để emulator gọi được.
# VPS: đặt IP Tailscale (Docker mở cổng vòng qua ufw, 0.0.0.0 sẽ lộ API ra Internet).
API_BIND_ADDR=0.0.0.0
API_HOST_PORT=8080
# Sao lưu hằng ngày (chỉ máy chủ chung): giờ UTC (19 = 2 giờ sáng VN) và số ngày giữ lại
BACKUP_HOUR_UTC=19
BACKUP_KEEP_DAYS=7
